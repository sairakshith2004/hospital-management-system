{
  "name": "@hospitalos/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "tsx --env-file=../../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:env:check": "tsx --env-file=../../.env src/db/check-env.ts",
    "db:roles": "tsx --env-file=../../.env src/db/bootstrap-roles.ts",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts dev",
    "db:migrate:test": "tsx --env-file=../../.env src/db/migrate.ts test",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx --env-file=../../.env src/db/seed/run-seed.ts dev",
    "db:seed:test": "tsx --env-file=../../.env src/db/seed/run-seed.ts test",
    "test:db": "node --env-file=../../.env ../../node_modules/vitest/vitest.mjs run --config vitest.db.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "express": "5.3.0",
    "pg": "8.23.1",
    "pino": "10.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "supertest": "7.3.1",
    "tsx": "4.23.15"
  }
}
