{
  "name": "hospitalos",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "dev:api": "npm run dev -w @hospitalos/api",
    "dev:web": "npm run dev -w @hospitalos/web",
    "build": "npm run build --workspaces --if-present",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:psql": "docker compose exec db sh -c 'psql -U \"$POSTGRES_USER\" -d hms_dev'",
    "db:env:check": "npm run db:env:check -w @hospitalos/api",
    "db:roles": "npm run db:roles -w @hospitalos/api",
    "db:migrate": "npm run db:migrate -w @hospitalos/api",
    "db:migrate:test": "npm run db:migrate:test -w @hospitalos/api"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
