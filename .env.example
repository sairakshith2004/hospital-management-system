# Copy to .env and fill in local values. Never commit .env.
# Replace CHANGE_ME_OWNER and CHANGE_ME_APP before CHANGE_ME (see README, "Getting started").
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# API log level: fatal, error, warn, info, debug or silent
LOG_LEVEL=info
# Signs the session cookie. Replace with your own: openssl rand -hex 32 (never commit it).
SESSION_SECRET=CHANGE_ME_SESSION
# Reverse-proxy hops to trust for client IPs: false (default, local) or 1-3 behind a host's proxy.
TRUST_PROXY=false
POSTGRES_USER=hms
POSTGRES_PASSWORD=

# Local superuser: used only by npm run db:roles. Must point at 127.0.0.1 or localhost.
ADMIN_DATABASE_URL=postgres://hms:CHANGE_ME@127.0.0.1:5432/hms_dev

# Schema owner (hms_owner): migrations only. Same password for both databases.
MIGRATION_DATABASE_URL=postgres://hms_owner:CHANGE_ME_OWNER@127.0.0.1:5432/hms_dev
TEST_MIGRATION_DATABASE_URL=postgres://hms_owner:CHANGE_ME_OWNER@127.0.0.1:5432/hms_test

# Application (hms_app): the API and database tests. Same password for both databases.
DATABASE_URL=postgres://hms_app:CHANGE_ME_APP@127.0.0.1:5432/hms_dev
TEST_DATABASE_URL=postgres://hms_app:CHANGE_ME_APP@127.0.0.1:5432/hms_test

# Video meetings through the LiveKit media server (optional; all three or none).
# Without them, meetings use browser-to-browser video for up to 8 people.
# Start it with: npm run video:up. Secret: openssl rand -hex 32 (never commit it).
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_API_KEY=hospitalos
# LIVEKIT_API_SECRET=
